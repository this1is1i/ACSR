flowchart TD
    A([🧑‍🔬 用户请求<br/>POST /recommend<br/>user_id + k]) --> B

    subgraph API ["🌐 API 服务层 · api/server.py"]
        B[FastAPI 路由<br/>请求验证 · CORS]
    end

    B --> C

    subgraph SVC ["⚙️ 推荐服务层 · recommendation_service.py"]
        C[get_recommendations<br/>user_id, k, history]
    end

    C --> D

    subgraph FEAT ["🔧 特征构建 · feature_builder.py"]
        D[get_user_features<br/>user_id → UserFeatures]
        D --> D1[build_state<br/>兴趣向量 ‖ 历史向量<br/>→ state ∈ ℝ⁶⁴]
        D -.->|预留| D2[(KG Embedding<br/>AMiner / GNN)]
        D -.->|预留| D3[(社区行为<br/>协同过滤)]
    end

    D1 --> E

    subgraph CAND ["📚 候选集生成 · candidate_generator.py"]
        E{召回策略}
        E -->|similarity| E1[余弦相似度检索<br/>cosine sim Top-M]
        E -->|popular| E2[高被引论文召回<br/>citation_count排序]
        E -->|hybrid 默认| E3[70% 相似 + 30% 热门<br/>混合去重]
        E1 --> E4[候选集 candidates<br/>List&#40;CandidateItem&#41;]
        E2 --> E4
        E3 --> E4
        E -.->|预留| E5[(MySQL · ES<br/>Faiss · Milvus)]
    end

    E4 --> F

    subgraph RANK ["🤖 强化学习排序 · ranker.py + agent.py"]
        F[recommend_top_k<br/>user_state + candidates]
        F --> F1[Actor π·a&#124;s·θ<br/>输出动作概率]
        F --> F2[语义相似度<br/>cos_sim&#40;u, p_i&#41;]
        F1 --> F3[综合分<br/>0.6·Actor + 0.4·cosine]
        F2 --> F3
        F3 --> F4[TopK排序<br/>List&#40;RankedItem&#41;]
    end

    F4 --> G

    subgraph EXP ["💡 推荐解释 · explain.py"]
        G[batch_explain<br/>user + items]
        G --> G1{解释维度}
        G1 --> G2[语义相似度<br/>sim > 70%]
        G1 --> G3[研究方向重叠<br/>topic_overlap]
        G1 --> G4[学术影响力<br/>citation > 300]
        G1 --> G5[时效性<br/>year ≥ 2023]
        G2 --> G6[结构化推荐理由<br/>reason + details]
        G3 --> G6
        G4 --> G6
        G5 --> G6
        G6 -.->|预留| G7[LLM改写<br/>ChatGLM / GPT]
    end

    G6 --> H

    subgraph RESP ["📦 返回推荐结果"]
        H[组装 RecommendationResponse]
        H --> H1["JSON 响应<br/>{<br/>  paper_id, title, score<br/>  reason, similarity_score<br/>  confidence, topics<br/>}"]
    end

    H1 --> I([✅ 返回 Spring Boot<br/>/ 前端])

    style A fill:#4299E1,color:#fff,stroke:none
    style I fill:#48BB78,color:#fff,stroke:none
    style API fill:#EBF8FF,stroke:#4299E1
    style SVC fill:#F0FFF4,stroke:#48BB78
    style FEAT fill:#FAF5FF,stroke:#9F7AEA
    style CAND fill:#E6FFFA,stroke:#38B2AC
    style RANK fill:#FFFAF0,stroke:#F6AD55
    style EXP fill:#FFF5F5,stroke:#FC8181
    style RESP fill:#F0FFF4,stroke:#48BB78