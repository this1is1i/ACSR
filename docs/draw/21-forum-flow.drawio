<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/27.0.9 Chrome/134.0.6998.205 Electron/35.4.0 Safari/537.36" version="27.0.9">
  <diagram name="论坛功能流转图" id="forum-flow">
    <mxGraphModel dx="808" dy="516" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="user-lane" value="普通用户" style="swimlane;startSize=30;fontStyle=1;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="40" y="80" width="320" height="1380" as="geometry" />
        </mxCell>
        <mxCell id="node-create" value="创建帖子&lt;br&gt;填写标题、正文、关联论文" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" parent="user-lane" vertex="1">
          <mxGeometry x="80" y="50" width="160" height="50" as="geometry" />
        </mxCell>
