        <mxCell id="lSV9-O2tTNXb6Zu_E3IN-7" value="&lt;font&gt;否&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=14;" vertex="1" connectable="0" parent="e12">
          <mxGeometry x="-0.1331" relative="1" as="geometry">
            <mxPoint as="offset" />
