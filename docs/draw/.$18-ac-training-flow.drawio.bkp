        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=14;" parent="1" source="reset" target="step1a" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="420" y="140" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step1a" value="Actor(s, F) → softmax → 采样a" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="190" y="170" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step2a" value="&lt;font&gt;env.step(a)&lt;br&gt;&amp;nbsp;cos=dot(interest,paper_vec)&lt;br&gt;  → 模拟 click/fav/read (概率采样)&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=left;spacingLeft=4;" parent="1" vertex="1">
          <mxGeometry x="175" y="280" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=14;" parent="1" source="step1a" target="step2a" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="270" y="339.9999999999999" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=14;" parent="1" source="lSV9-O2tTNXb6Zu_E3IN-3" target="td" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="235" as="targetPoint" />
            <Array as="points">
              <mxPoint x="270" y="458" />
              <mxPoint x="390" y="458" />
              <mxPoint x="390" y="200" />
              <mxPoint x="580" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="td" value="&lt;b&gt;δ = r + 0.99·V(s&#39;)·(1-done) - V(s)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Courier New;" parent="1" vertex="1">
          <mxGeometry x="490" y="220" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="critic" value="Critic: min δ² → backward → clip_grad → step" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=left;spacingLeft=4;" parent="1" vertex="1">
          <mxGeometry x="510" y="290" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=14;" parent="1" source="td" target="critic" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="actor" value="Actor: max logπ·sg(δ) + 0.01·H(π) → backward → clip → step" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=left;spacingLeft=4;" parent="1" vertex="1">
          <mxGeometry x="470" y="375" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=14;" parent="1" source="critic" target="actor" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="accum" value="epReward += r,  s = s&#39;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="505" y="440" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=14;" parent="1" source="actor" target="accum" edge="1">
