        <mxCell id="lSV9-O2tTNXb6Zu_E3IN-3" value="&lt;font&gt;&amp;nbsp; r = 6维加权奖励&lt;br&gt;&amp;nbsp;s&#39; = EMA平滑 + L2归一&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=left;spacingLeft=4;" vertex="1" parent="1">
