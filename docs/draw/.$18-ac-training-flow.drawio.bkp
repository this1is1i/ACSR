<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/27.0.9 Chrome/134.0.6998.205 Electron/35.4.0 Safari/537.36" version="27.0.9">
  <diagram id="ac-train" name="AC网络单轮训练流程">
    <mxGraphModel dx="668" dy="427" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="开始: env.reset()" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="320" y="10" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="reset" value="随机采样用户构建状态 s(96维)&lt;br&gt;生成候选 F(50×32) + 过滤已读" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="320" y="70" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=14;" parent="1" source="start" target="reset" edge="1">
