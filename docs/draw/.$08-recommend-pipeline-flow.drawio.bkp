          <mxGeometry as="geometry" x="140" y="545" width="440" height="48" />
        </mxCell>
        <mxCell id="s4b" parent="1" vertex="1" value="使用模板文本回退&#10;&quot;基于您的科研兴趣推荐&quot;" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;fontSize=10;rounded=1;">
