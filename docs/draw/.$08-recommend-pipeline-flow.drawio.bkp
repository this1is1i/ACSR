        </mxCell>
        <mxCell id="s1c" parent="1" vertex="1" value="使用随机向量回退&#10;(确定性哈希种子)" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;fontSize=10;rounded=1;">
          <mxGeometry as="geometry" x="40" y="160" width="170" height="50" />
