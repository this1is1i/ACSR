        <mxCell id="s1d" parent="1" vertex="1" value="build_state() → 拼接96维向量 → L2归一化" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;fontSize=11;">
          <mxGeometry as="geometry" x="200" y="240" width="400" height="42" />
        </mxCell>
