<mxfile host="Electron" agent="Claude Code" version="27.0.9">
  <diagram name="论文导入流程" id="paper-import-flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== 标题 ===== -->
        <mxCell id="title-paper" value="&lt;b style=&quot;font-size:16px&quot;&gt;论文导入功能代码流程&lt;/b&gt;&lt;br&gt;Paper Import — submitPaperImport() → AdminServiceImpl.importPapers()" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="20" width="480" height="45" as="geometry" />
        </mxCell>

        <!-- ===== 前端区域背景 ===== -->
        <mxCell id="fe-bg" value="&lt;b&gt;前端 Vue (AdminConsole.vue)&lt;/b&gt;" style="swimlane;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="620" height="580" as="geometry" />
        </mxCell>

        <!-- 1. 起始 -->
        <mxCell id="p1" value="管理员进入&lt;br&gt;论文导入标签页" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="fe-bg">
          <mxGeometry x="210" y="40" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- 2. 编辑 JSON -->
        <mxCell id="p2" value="编辑 JSON 文本框&lt;br&gt;paperImportText" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="fe-bg">
          <mxGeometry x="190" y="120" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="fe-bg" source="p1" target="p2" style="endArrow=classic;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. 点击导入 -->
        <mxCell id="p3" value="点击「导入论文」按钮&lt;br&gt;submitPaperImport()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="fe-bg">
          <mxGeometry x="190" y="200" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="fe-bg" source="p2" target="p3" style="endArrow=classic;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. JSON.parse 校验 -->
        <mxCell id="p4" value="JSON.parse()&lt;br&gt;格式校验" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="fe-bg">
          <mxGeometry x="190" y="280" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="fe-bg" source="p3" target="p4" style="endArrow=classic;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4a. 校验失败 -->
        <mxCell id="p4a" value="ElMessage.error&lt;br&gt;「请输入合法的JSON数组」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="fe-bg">
          <mxGeometry x="420" y="285" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e4a" value="失败" edge="1" parent="fe-bg" source="p4" target="p4a" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#fff2cc;fontSize=10;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5. 字段归一化 -->
        <mxCell id="p5" value="字段归一化&lt;br&gt;authors/keywords 字符串→数组" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="fe-bg">
          <mxGeometry x="175" y="380" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="成功" edge="1" parent="fe-bg" source="p4" target="p5" style="endArrow=classic;html=1;labelBackgroundColor=#fff2cc;fontSize=10;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 6. POST API -->
        <mxCell id="p6" value="POST /api/admin/papers/import&lt;br&gt;importAdminPapers({ papers })" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;size=0.2;" vertex="1" parent="fe-bg">
          <mxGeometry x="160" y="460" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="fe-bg" source="p5" target="p6" style="endArrow=classic;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 7. 显示成功 -->
        <mxCell id="p13" value="ElMessage.success&lt;br&gt;「成功导入 N 篇论文」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="fe-bg">
          <mxGeometry x="190" y="530" width="180" height="45" as="geometry" />
        </mxCell>

        <!-- ===== 后端区域背景 ===== -->
        <mxCell id="be-bg" value="&lt;b&gt;后端 Spring Boot (AdminController → AdminServiceImpl)&lt;/b&gt;" style="swimlane;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="620" height="680" as="geometry" />
        </mxCell>

        <!-- 跨层连接：POST → Controller -->
        <mxCell id="e7" value="HTTP Request (JWT Auth)" edge="1" parent="1" source="p6" target="b1" style="endArrow=classic;html=1;dashed=1;strokeWidth=2;labelBackgroundColor=#f5f5f5;fontSize=10;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- B1. Controller -->
        <mxCell id="b1" value="AdminController.importPapers()&lt;br&gt;@PostMapping + ADMIN 鉴权" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="be-bg">
          <mxGeometry x="190" y="40" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- B2. Service -->
        <mxCell id="b2" value="AdminServiceImpl.importPapers()&lt;br&gt;@Transactional 事务边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="be-bg">
          <mxGeometry x="180" y="120" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="eb1" edge="1" parent="be-bg" source="b1" target="b2" style="endArrow=classic;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- B3. 遍历论文 -->
        <mxCell id="b3" value="遍历 for each PaperImportItem&lt;br&gt;index=0..N-1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;size=0.2;" vertex="1" parent="be-bg">
          <mxGeometry x="185" y="200" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eb2" edge="1" parent="be-bg" source="b2" target="b3" style="endArrow=classic;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 子流程组 -->
        <mxCell id="sub-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;strokeWidth=1;dashed=1;dashPattern=5 3;" vertex="1" parent="be-bg">
          <mxGeometry x="80" y="290" width="480" height="345" as="geometry" />
        </mxCell>
        <mxCell id="sub-label" value="每篇论文的处理子流程 (upsertShadowPaper + matchAuthorsForClaim)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontStyle=italic;" vertex="1" parent="be-bg">
          <mxGeometry x="90" y="293" width="380" height="20" as="geometry" />
        </mxCell>

        <!-- S1. 生成 aminerId -->
        <mxCell id="s1" value="生成/校验 aminerId&lt;br&gt;为空则 `manual_`+timestamp+index" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="be-bg">
          <mxGeometry x="250" y="320" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="eb3" edge="1" parent="be-bg" source="b3" target="s1" style="endArrow=classic;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S2. Upsert -->
        <mxCell id="s2" value="upsertShadowPaper()&lt;br&gt;INSERT 或 UPDATE paper 表" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;size=10;" vertex="1" parent="be-bg">
          <mxGeometry x="260" y="390" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="es1" edge="1" parent="be-bg" source="s1" target="s2" style="endArrow=classic;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S3. 作者匹配 -->
        <mxCell id="s3" value="matchAuthorsForClaim()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="be-bg">
          <mxGeometry x="265" y="470" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="es2" edge="1" parent="be-bg" source="s2" target="s3" style="endArrow=classic;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S3a 精确匹配 -->
        <mxCell id="s3a" value="精确匹配: username == authorName" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="be-bg">
          <mxGeometry x="100" y="530" width="175" height="35" as="geometry" />
        </mxCell>
        <mxCell id="es3a" value="命中" edge="1" parent="be-bg" source="s3" target="s3a" style="endArrow=classic;html=1;labelBackgroundColor=#d5e8d4;fontSize=9;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S3b 模糊匹配 -->
        <mxCell id="s3b" value="模糊匹配: LIKE + 置信度计算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="be-bg">
          <mxGeometry x="330" y="530" width="175" height="35" as="geometry" />
        </mxCell>
        <mxCell id="es3b" value="未命中" edge="1" parent="be-bg" source="s3" target="s3b" style="endArrow=classic;html=1;labelBackgroundColor=#fff2cc;fontSize=9;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S4. 创建认领 -->
        <mxCell id="s4" value="createClaimIfNew()&lt;br&gt;INSERT paper_author_claim" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;size=10;" vertex="1" parent="be-bg">
          <mxGeometry x="210" y="585" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="es4a" edge="1" parent="be-bg" source="s3a" target="s4" style="endArrow=classic;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es4b" edge="1" parent="be-bg" source="s3b" target="s4" style="endArrow=classic;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- B4. Neo4j 同步 -->
        <mxCell id="b4" value="graphPaperService.upsertPapers()&lt;br&gt;批量同步 → Neo4j GraphPaper 节点" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;size=10;" vertex="1" parent="be-bg">
          <mxGeometry x="180" y="380" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="eb4" value="遍历完成后批量写入" edge="1" parent="be-bg" source="b3" target="b4" style="endArrow=classic;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#fff2cc;fontSize=9;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- B5. 返回结果 -->
        <mxCell id="b5" value="返回 PaperImportResult&lt;br&gt;{ importedCount, aminerIds }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="be-bg">
          <mxGeometry x="190" y="600" width="220" height="50" as="geometry" />
        </mxCell>
        <!-- arrows to b5 -->
        <mxCell id="eb5a" edge="1" parent="be-bg" source="b4" target="b5" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb5b" edge="1" parent="be-bg" source="s4" target="b5" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 跨层连接：Result → 前端显示 -->
        <mxCell id="e8" value="HTTP Response Result data" edge="1" parent="1" source="b5" target="p13" style="endArrow=classic;html=1;dashed=1;strokeWidth=2;labelBackgroundColor=#f5f5f5;fontSize=10;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 右侧：训练结果展示流程 ===== -->
        <mxCell id="title-train" value="&lt;b style=&quot;font-size:16px&quot;&gt;模型训练结果展示代码流程&lt;/b&gt;&lt;br&gt;Training Result Display — doTriggerTraining() → 轮询 → 结果弹窗" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="730" y="20" width="520" height="45" as="geometry" />
        </mxCell>

        <!-- 前端区域 -->
        <mxCell id="fe2-bg" value="&lt;b&gt;前端 Vue (AdminConsole.vue)&lt;/b&gt;" style="swimlane;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="730" y="80" width="510" height="720" as="geometry" />
        </mxCell>

        <!-- T1. 起始 -->
        <mxCell id="t1" value="管理员进入&lt;br&gt;模型训练标签页" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="fe2-bg">
          <mxGeometry x="185" y="40" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- T2. 配置参数 -->
        <mxCell id="t2" value="配置训练轮数（可选）&lt;br&gt;trainingEpisodes (1~2000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="fe2-bg">
          <mxGeometry x="165" y="120" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="et1" edge="1" parent="fe2-bg" source="t1" target="t2" style="endArrow=classic;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- T3. 点击训练 -->
        <mxCell id="t3" value="点击「实时训练」按钮&lt;br&gt;doTriggerTraining()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="fe2-bg">
          <mxGeometry x="165" y="200" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="et2" edge="1" parent="fe2-bg" source="t2" target="t3" style="endArrow=classic;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- T4. 调用训练API -->
        <mxCell id="t4" value="POST /api/recommend/train&lt;br&gt;triggerTraining(episodes)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;size=0.2;" vertex="1" parent="fe2-bg">
          <mxGeometry x="140" y="280" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="et3" edge="1" parent="fe2-bg" source="t3" target="t4" style="endArrow=classic;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- T5. 失败分支 -->
        <mxCell id="t5" value="ElMessage.error&lt;br&gt;「请检查Python推荐服务」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="fe2-bg">
          <mxGeometry x="380" y="285" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="et5" value="失败" edge="1" parent="fe2-bg" source="t4" target="t5" style="endArrow=classic;html=1;labelBackgroundColor=#fff2cc;fontSize=10;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- T6. 启动轮询 -->
        <mxCell id="t6" value="startTrainingPoll()&lt;br&gt;setInterval 2000ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="fe2-bg">
          <mxGeometry x="165" y="360" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="et6" value="成功" edge="1" parent="fe2-bg" source="t4" target="t6" style="endArrow=classic;html=1;labelBackgroundColor=#fff2cc;fontSize=10;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- T7. 轮询查询 -->
        <mxCell id="t7" value="GET /api/recommend/model/info&lt;br&gt;getModelInfo()" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;size=0.2;" vertex="1" parent="fe2-bg">
          <mxGeometry x="140" y="440" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="et7" edge="1" parent="fe2-bg" source="t6" target="t7" style="endArrow=classic;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- T8. 判断训练状态 -->
        <mxCell id="t8" value="检查 is_training&lt;br&gt;字段?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="fe2-bg">
          <mxGeometry x="175" y="520" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="et8" edge="1" parent="fe2-bg" source="t7" target="t8" style="endArrow=classic;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 轮询回路 -->
        <mxCell id="t8b" value="显示「训练中...」&lt;br&gt;继续轮询 (2s后)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="fe2-bg">
          <mxGeometry x="380" y="525" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="et8b" value="true" edge="1" parent="fe2-bg" source="t8" target="t8b" style="endArrow=classic;html=1;exitX=1;exitY=0.5;labelBackgroundColor=#fff2cc;fontSize=10;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 回路箭头：从 t8b 回到 t7 -->
        <mxCell id="eloop" value="循环轮询" edge="1" parent="fe2-bg" source="t8b" target="t7" style="endArrow=classic;html=1;exitX=0.5;exitY=0;entryX=1;entryY=0.5;rounded=1;curved=1;strokeColor=#d6b656;strokeWidth=1;dashed=1;labelBackgroundColor=#fff2cc;fontSize=10;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="440" y="490" />
              <mxPoint x="440" y="465" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- T9. 停止轮询 + 计算结果 -->
        <mxCell id="t9" value="clearInterval 停止轮询&lt;br&gt;计算 trainingDuration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="fe2-bg">
          <mxGeometry x="160" y="620" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="et9" value="false" edge="1" parent="fe2-bg" source="t8" target="t9" style="endArrow=classic;html=1;labelBackgroundColor=#fff2cc;fontSize=10;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- T10. 结果弹窗 -->
        <mxCell id="t10" value="弹出训练结果对话框&lt;br&gt;trainingResultVisible = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="fe2-bg">
          <mxGeometry x="150" y="695" width="210" height="45" as="geometry" />
        </mxCell>
        <mxCell id="et10" edge="1" parent="fe2-bg" source="t9" target="t10" style="endArrow=classic;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 结果详情注释框 -->
        <mxCell id="t11" value="&lt;b&gt;训练结果展示项:&lt;/b&gt;&lt;br&gt;• best_reward (最优奖励)&lt;br&gt;• last_episode (训练轮数)&lt;br&gt;• model_version (模型版本)&lt;br&gt;• trainingDuration (训练耗时)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="fe2-bg">
          <mxGeometry x="110" y="755" width="290" height="75" as="geometry" />
        </mxCell>
        <mxCell id="et11" edge="1" parent="fe2-bg" source="t10" target="t11" style="endArrow=classic;html=1;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 后端 + Python 标注框 ===== -->
        <mxCell id="be2-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;strokeWidth=1;dashed=1;dashPattern=5 3;" vertex="1" parent="1">
