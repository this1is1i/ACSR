<mxfile host="Electron" version="27.0.9">
  <diagram id="ac-train" name="AC网络单轮训练流程">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="开始: env.reset()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="320" y="30" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="reset" value="随机采样用户 → 构建状态 s(96维)&#xa;生成候选 F(50×32) + 过滤已读" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="290" y="85" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="start" target="reset" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="loop" value="FOR step = 1 TO 50" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="320" y="155" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="reset" target="loop" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="① 选择动作" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="230" width="140" height="35" as="geometry" />
        </mxCell>
        <mxCell id="step1a" value="Actor(s, F) → softmax → 采样a" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="30" y="275" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="loop" target="step1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="step1" target="step1a" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="② 环境反馈" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="260" y="230" width="140" height="35" as="geometry" />
        </mxCell>
        <mxCell id="step2a" value="env.step(a)&#xa;  → cos=dot(interest,paper_vec)&#xa;  → 模拟 click/fav/read (概率采样)&#xa;  → r = 6维加权奖励&#xa;  → s' = EMA平滑 + L2归一" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;align=left;spacingLeft=4;" parent="1" vertex="1">
          <mxGeometry x="240" y="275" width="180" height="95" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="step1a" target="step2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="step2" target="step2a" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="③ TD(0)更新" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="480" y="230" width="140" height="35" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="step2a" target="step3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="td" value="δ = r + 0.99·V(s')·(1-done) - V(s)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1">
          <mxGeometry x="450" y="280" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="step3" target="td" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="critic" value="Critic: min δ² → backward → clip_grad → step" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;align=left;spacingLeft=4;" parent="1" vertex="1">
          <mxGeometry x="440" y="325" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="td" target="critic" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="actor" value="Actor: max logπ·sg(δ) + 0.01·H(π) → backward → clip → step" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;align=left;spacingLeft=4;" parent="1" vertex="1">
          <mxGeometry x="410" y="375" width="330" height="35" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="critic" target="actor" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="accum" value="epReward += r,  s = s'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="480" y="430" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="actor" target="accum" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="check" value="done OR step=50?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="495" y="480" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="accum" target="check" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" parent="1" source="check" target="loop" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="20" y="510" /><mxPoint x="20" y="220" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="label-no" value="否" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="10" y="380" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="end" value="返回 (R_ep, avg_L_A, avg_δ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="300" y="570" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="check" target="end" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="label-yes" value="是" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="575" y="535" width="30" height="20" as="geometry" />
        </mxCell>
        <mxCell id="save" value="R_ep &gt; best? → 保存 ac_model.pth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="290" y="635" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="end" target="save" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
