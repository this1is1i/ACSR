<mxfile host="Electron" version="27.0.9">
  <diagram id="learn-path" name="学习路径四层节点生成">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="build_path(user_id, history, target_topic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="230" y="20" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="① 提取已掌握关键词" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="270" y="85" width="220" height="35" as="geometry" />
        </mxCell>
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="start" target="step1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step1a" value="_extract_known_keywords(history)&#xa;遍历历史论文 → 统计每个关键词出现次数&#xa;归一化: count / |history| → 取 top 5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;align=left;spacingLeft=4;" parent="1" vertex="1">
          <mxGeometry x="230" y="130" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="step1" target="step1a" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kw-box1" value="Layer 0: 已掌握关键词 (≤5个)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="130" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e1b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;dashed=1;" parent="1" source="step1a" target="kw-box1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mastery1" value="mastery = 频率 (0.33~1.0)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=9;fontColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="45" y="170" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="② 查找目标主题簇" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="270" y="210" width="220" height="35" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="step1a" target="step2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step2a" value="get_keyword_cluster(target_topic)&#xa;在 KG 中统计关键词共现频率&#xa;取 top-5 共现词 + top-5 论文" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;align=left;spacingLeft=4;" parent="1" vertex="1">
          <mxGeometry x="230" y="255" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="step2" target="step2a" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kw-box2" value="Layer 1: 相关关键词 (≤5个)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="560" y="260" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e3b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;dashed=1;" parent="1" source="step2a" target="kw-box2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mastery2" value="mastery = 0.0 (若不在已掌握中)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=9;fontColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="570" y="300" width="170" height="20" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="③ 置入目标关键词" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="270" y="340" width="220" height="35" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="step2a" target="step3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kw-box3" value="Layer 2: 目标关键词 (1个)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="310" y="395" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="step3" target="kw-box3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step4" value="④ 追加目标论文" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="270" y="460" width="220" height="35" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="kw-box3" target="step4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kw-box4" value="Layer 3: 目标论文 (≤max_nodes-11)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="250" y="510" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="step4" target="kw-box4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mastery4" value="mastery = 0.0 (尚未阅读)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=9;fontColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="280" y="550" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="step5" value="⑤ 构建有向边" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="270" y="590" width="220" height="35" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="kw-box4" target="step5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step5a" value="depth i → depth i+1&#xa;边权 = 1/(|pos_i - pos_j| + 1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;align=left;spacingLeft=4;" parent="1" vertex="1">
          <mxGeometry x="270" y="635" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="step5" target="step5a" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="end" value="返回 LearningPath (≤20 nodes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="240" y="700" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="step5a" target="end" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
