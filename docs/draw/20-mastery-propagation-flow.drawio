        <mxCell id="SgCUEj7IBKP52pg-E7VI-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="start" target="step1">
          <mxGeometry relative="1" as="geometry" />
