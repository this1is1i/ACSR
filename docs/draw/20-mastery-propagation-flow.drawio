          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="timew" value="δ₀ = 1.0 × (i+1)/n&#xa;越晚读(大i)权重越大, 模拟遗忘" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=4;fontStyle=0" parent="1" vertex="1">
          <mxGeometry x="305" y="70" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=0;fontSize=13;" parent="1" source="step1" target="timew" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="direct" value="mastery[paper_i] += δ₀&#xa;clip 到 1.0 (防溢出)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=4;fontStyle=0" parent="1" vertex="1">
          <mxGeometry x="325" y="130" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="&amp;nbsp;递归传播&lt;div&gt;&amp;nbsp;_propagate(paper_i, δ₀, hop=0)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=0;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="90" y="130" width="210" height="40" as="geometry" />
