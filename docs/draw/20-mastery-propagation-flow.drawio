        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=0;fontSize=13;" parent="1" source="direct" target="step3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="prop-detail" value="FOR each edge (paper_i → neighbor):&lt;br&gt;  rel_w = (has_keyword:0.8 | cite:0.4 | publish_in:0.3)不同边类型不同权重" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=4;fontStyle=0" parent="1" vertex="1">
          <mxGeometry x="230" y="210" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=0;fontSize=13;" parent="1" source="step3" target="prop-detail" edge="1">
