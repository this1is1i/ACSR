        <mxCell id="SgCUEj7IBKP52pg-E7VI-8" value="&lt;span style=&quot;font-size: 13px; text-align: left;&quot;&gt;new_δ = δ × 0.6 × rel_w × edge_weight&lt;/span&gt;&lt;div style=&quot;font-size: 13px; text-align: left;&quot;&gt;每一跳进行衰减&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
