        <mxCell id="result-a" value="apply_to_path(path): 更新 PathNode.mastery&#xa;get_color_mapping(): 蓝(0.0)→橙(0.5)→绿(1.0)&#xa;get_glow_intensity(): mastery值 → three.js emissive" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=4;fontStyle=0" parent="1" vertex="1">
