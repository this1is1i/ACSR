<mxfile host="Electron" version="27.0.9">
  <diagram id="mastery-prop" name="掌握度传播递归计算">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="batch_update(history)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="280" y="20" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="init" value="FOR each paper_i IN history (i=0..n-1):" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="270" y="80" width="270" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="start" target="init" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="① 时间衰减权重" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="305" y="145" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="init" target="step1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="timew" value="δ₀ = 1.0 × (i+1)/n&#xa;越晚读(大i)权重越大, 模拟遗忘" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;align=left;spacingLeft=4;" parent="1" vertex="1">
          <mxGeometry x="290" y="185" width="230" height="35" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="step1" target="timew" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="② 直接更新事件节点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="290" y="240" width="230" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="timew" target="step2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="direct" value="mastery[paper_i] += δ₀&#xa;clip 到 1.0 (防溢出)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;" parent="1" vertex="1">
          <mxGeometry x="285" y="280" width="240" height="35" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="step2" target="direct" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="③ 递归传播 _propagate(paper_i, δ₀, hop=0)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="260" y="340" width="290" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="direct" target="step3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="prop-detail" value="FOR each edge (paper_i → neighbor):&#xa;  rel_w = (has_keyword:0.8 | cite:0.4 | publish_in:0.3)&#xa;  new_δ = δ × 0.6 × rel_w × edge_weight&#xa;  IF new_δ ≥ 1e-4 AND ∃ neighbor 未被更大δ访问:&#xa;    mastery[neighbor] = min(1.0, old + new_δ)&#xa;    RECURSE _propagate(neighbor, new_δ, hop+1)  ← 递归&#xa;  ELSE: 停止该分支" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;align=left;spacingLeft=4;" parent="1" vertex="1">
          <mxGeometry x="170" y="385" width="470" height="105" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="step3" target="prop-detail" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cond" value="hop ≥ 3 OR δ &lt; 1e-4?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="310" y="510" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="prop-detail" target="cond" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="end-branch" value="停止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="565" y="520" width="70" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c00;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="cond" target="end-branch" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="label-yes" value="是" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#c00;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="520" y="525" width="30" height="20" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#090;endArrow=block;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="cond" target="step3" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="100" y="565" /><mxPoint x="100" y="355" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="label-no" value="否, 继续 | 用new_δ递归取neighbor" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=9;fontColor=#090;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="5" y="440" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="result" value="④ 应用到路径并生成可视化" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="270" y="600" width="270" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="end-branch" target="result" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="result-a" value="apply_to_path(path): 更新 PathNode.mastery&#xa;get_color_mapping(): 蓝(0.0)→橙(0.5)→绿(1.0)&#xa;get_glow_intensity(): mastery值 → three.js emissive" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;align=left;spacingLeft=4;" parent="1" vertex="1">
          <mxGeometry x="200" y="645" width="410" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="result" target="result-a" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="end" value="PathNode 数组: 含 mastery + color + glow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="220" y="720" width="370" height="35" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333;endArrow=block;" parent="1" source="result-a" target="end" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
